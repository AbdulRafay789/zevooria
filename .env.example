# Database (PostgreSQL) — copy to untracked .env at repo root
# Never commit real credentials.
DB_HOST=localhost
DB_PORT=5432
DB_USER=zevooria
DB_PASSWORD=zevooria
DB_NAME=zevooria
# Set DB_SSL=true for AWS RDS
DB_SSL=false
# Path to AWS RDS CA bundle (required when DB_SSL=true).
# Production API image defaults to /certs/rds/global-bundle.pem
# DB_SSL_CA=/certs/rds/global-bundle.pem

# API
PORT=3001
TYPEORM_LOGGING=false

# Optional host port mappings for Compose on EC2
# API_PORT=3001
# WEB_PORT=3000
