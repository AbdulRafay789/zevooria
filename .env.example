# Database (PostgreSQL) — copy to untracked .env at repo root
# Never commit real credentials.
DB_HOST=localhost
DB_PORT=5432
DB_USER=zevooria
DB_PASSWORD=zevooria
DB_NAME=zevooria
# Set DB_SSL=true for AWS RDS
DB_SSL=false
# Path to AWS RDS CA bundle (required when DB_SSL=true).
# Production API image defaults to /certs/rds/global-bundle.pem
# DB_SSL_CA=/certs/rds/global-bundle.pem

# API
PORT=3001
TYPEORM_LOGGING=false
# Email (NestJS only — never expose AWS credentials to Next.js/browser).
# EMAIL_PROVIDER=console (local default) or ses (production on EC2).
# Production SES uses the EC2 IAM instance role via the AWS SDK default
# credential chain. Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
EMAIL_PROVIDER=console
AWS_REGION=ap-south-1
MAIL_FROM="Zevooria <no-reply@zevooria.com>"
# Support inbound S3 poller (Phase 2). Defaults off when EMAIL_PROVIDER=console
# (local has no IAM role). Production with EMAIL_PROVIDER=ses enables it via
# the EC2 instance role. Override explicitly if needed:
# SUPPORT_INBOUND_POLLING_ENABLED=false
# SUPPORT_INBOUND_POLLING_ENABLED=true
# SUPPORT_S3_BUCKET=zevooria-support-inbound-516644465984-ap-south-1-an
# SUPPORT_S3_INCOMING_PREFIX=incoming/
# Support outbound replies (Phase 5; SES SendRawEmail via EC2 IAM role)
# SUPPORT_MAIL_FROM="Zevooria Support <support@zevooria.com>"
# SUPPORT_FROM_EMAIL=support@zevooria.com

# Local Compose sets EMAIL_LOG_BODY=true so password-reset / verify tokens
# appear in `docker logs` even when NODE_ENV=production. Never enable in real prod.
# EMAIL_LOG_BODY=true

# Public origins for API CORS allowlist (comma not needed — one URL each).
# Production requires these; local fallback uses localhost:3000 / :3002.
WEB_PUBLIC_URL=https://zevooria.com
# ADMIN_PUBLIC_URL=https://admin.zevooria.com

# Storefront (apps/web)
# Server-side catalog fetch target (Docker Compose sets http://api:3001)
# API_URL=http://localhost:3001
# Browser API calls use Next.js rewrite /backend/* → API_URL
# Public customer storefront origin used in product-box QR codes
# (admin downloads encode WEB_PUBLIC_URL/products/{slug}).
# WEB_PUBLIC_URL is also listed under API CORS above.
# Local/default assets root is <repo>/assets when unset
# ASSETS_ROOT=/absolute/path/to/assets
# Compose sets ASSETS_ROOT=/app/assets on api (writable) and web (read-only)
# Compose bind-mount override (defaults to ./assets)
# ZEVOORIA_ASSETS_PATH=./assets

# Optional host port mappings for Compose on EC2
# API_PORT=3001
# WEB_PORT=3000
# ADMIN_PORT=3002

# Admin portal bootstrap (migration BootstrapAdminUsers + seed:admin)
# Password must meet creation policy: 8+ chars and at least 2 special characters.
# Migration falls back to local bootstrap defaults when unset — rotate after deploy.
# ADMIN_SEED_EMAIL=ops@yourdomain.com
# ADMIN_SEED_PASSWORD=YourPass!@12
# ADMIN_SEED_FULL_NAME=Zevooria Ops

# Demo staff accounts (migration BootstrapAdminUsers + seed:demo-staff)
# staff@ / sales@ / catalog@ / viewer@ zevooria.local
# ADMIN_DEMO_STAFF_PASSWORD=DemoStaff!!

# Admin Web Push (optional; generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@zevooria.com
